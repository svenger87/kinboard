# Traefik reverse-proxy override.
#
# Copy to `docker-compose.traefik.yml` and adjust to your setup, then run:
#   docker compose -f docker-compose.yml -f docker-compose.traefik.yml up -d
#
# Requirements:
#   - A Traefik instance running on the host with the entrypoints below
#   - The `proxy` network exists on the host (`docker network create proxy`)
#   - Set DOMAIN and TRAEFIK_CERT_RESOLVER in .env
#
# Variables read from .env:
#   DOMAIN                  e.g. kinboard.example.com
#   TRAEFIK_CERT_RESOLVER   name of your Traefik cert resolver (e.g. letsencrypt, cloudflare)
#   TRAEFIK_NETWORK         external network Traefik watches (default: proxy)

version: "3.8"

services:
  kong:
    # Inline rather than the anchor in docker-compose.yml: YAML anchors
    # don't cross files, so an overlay that adds a service has to cap its
    # own logs or that container writes without limit.
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - kinboard
      - traefik
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.${PROJECT_NAME:-kinboard}-api.rule=Host(`${DOMAIN}`) && (PathPrefix(`/rest`) || PathPrefix(`/auth`) || PathPrefix(`/storage`) || PathPrefix(`/realtime`))"
      - "traefik.http.routers.${PROJECT_NAME:-kinboard}-api.entrypoints=websecure"
      - "traefik.http.routers.${PROJECT_NAME:-kinboard}-api.tls.certresolver=${TRAEFIK_CERT_RESOLVER:-letsencrypt}"
      - "traefik.http.routers.${PROJECT_NAME:-kinboard}-api.priority=100"
      - "traefik.http.services.${PROJECT_NAME:-kinboard}-api.loadbalancer.server.url=http://${PROJECT_NAME:-kinboard}-kong:8000"

  webapp:
    # Inline rather than the anchor in docker-compose.yml: YAML anchors
    # don't cross files, so an overlay that adds a service has to cap its
    # own logs or that container writes without limit.
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - kinboard
      - traefik
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.${PROJECT_NAME:-kinboard}-webapp.rule=Host(`${DOMAIN}`)"
      - "traefik.http.routers.${PROJECT_NAME:-kinboard}-webapp.entrypoints=websecure"
      - "traefik.http.routers.${PROJECT_NAME:-kinboard}-webapp.tls.certresolver=${TRAEFIK_CERT_RESOLVER:-letsencrypt}"
      - "traefik.http.routers.${PROJECT_NAME:-kinboard}-webapp.priority=1"
      - "traefik.http.services.${PROJECT_NAME:-kinboard}-webapp.loadbalancer.server.url=http://${PROJECT_NAME:-kinboard}-webapp:3000"

  # Optional: route go2rtc's WebRTC TCP fallback through Traefik. Only enable
  # if your Traefik static config defines a `webrtc` TCP entrypoint and you
  # actually need WebRTC TCP fallback (most setups work over UDP and can
  # leave the host-published 8555/udp port open via UFW directly). Without
  # the matching entrypoint, Traefik logs `EntryPoint doesn't exist` errors
  # every ~10 seconds.
  #
  # go2rtc:
  #   networks:
  #     - kinboard
  #     - traefik
  #   labels:
  #     - "traefik.enable=true"
  #     - "traefik.tcp.routers.go2rtc-webrtc.rule=HostSNI(`*`)"
  #     - "traefik.tcp.routers.go2rtc-webrtc.entrypoints=webrtc"
  #     - "traefik.tcp.routers.go2rtc-webrtc.service=go2rtc-webrtc"
  #     - "traefik.tcp.services.go2rtc-webrtc.loadbalancer.server.port=8555"

networks:
  traefik:
    name: ${TRAEFIK_NETWORK:-proxy}
    external: true
