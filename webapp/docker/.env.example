# Kinboard — Docker Environment Variables
# Copy to .env and fill in your values. Run `../setup.sh` from the
# repo root to generate the random secrets automatically.

# ============================================================
# Project
# ============================================================
# Container name prefix (e.g. kinboard-db, kinboard-webapp)
PROJECT_NAME=kinboard

# Bind paths for persistent data. Defaults to ./data (relative to the
# docker-compose.yml). For NAS / production, set to a stable host path
# such as /mnt/user/appdata/kinboard.
DATA_DIR=./data

# Timezone for the webapp + go2rtc containers. IANA zone name. Used
# by server-side date/time formatting (push notification bodies, cron
# timestamps). Default Europe/Berlin matches the project's German-first
# heritage; self-hosters elsewhere set their household's IANA zone
# (e.g. America/New_York, Asia/Tokyo). Wrong zone → push notifications
# for local-time events show up off by the UTC offset.
TZ=Europe/Berlin

# ============================================================
# Required — generate before first start
# ============================================================
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Generate with: openssl rand -base64 64
SECRET_KEY_BASE=

# ============================================================
# Supabase API keys
# Generate at: https://supabase.com/docs/guides/self-hosting#api-keys
# ============================================================
ANON_KEY=
SERVICE_ROLE_KEY=

# ============================================================
# URLs
# ============================================================
# External URL the browser uses to reach Supabase. For a local stack:
#   http://localhost:${KONG_HTTP_PORT}
# Behind Traefik:
#   https://${DOMAIN}
API_EXTERNAL_URL=http://localhost:8100

# Site URL for OAuth redirects. Same host as API_EXTERNAL_URL above.
SITE_URL=http://localhost:3001

# Additional OAuth redirect URLs (comma-separated). Must NOT be empty —
# gotrue panics with a nil-pointer URL parse if it is. Defaults to the
# same value as SITE_URL above which is always safe.
ADDITIONAL_REDIRECT_URLS=http://localhost:3001

# JWT expiry in seconds (default 1 hour)
JWT_EXPIRY=3600

# ============================================================
# Ports
# ============================================================
# Webapp port on the host
WEBAPP_PORT=3001
# Postgres port on the host
POSTGRES_PORT=5432
# Kong (Supabase API gateway) ports on the host
KONG_HTTP_PORT=8100
KONG_HTTPS_PORT=8543
# go2rtc ports on the host (camera streaming)
GO2RTC_HTTP_PORT=1984
GO2RTC_WEBRTC_PORT=8555

# Internal Docker network subnet — change if 10.200.0.0/24 collides
NETWORK_SUBNET=10.200.0.0/24

# ============================================================
# Traefik (only used if you run with docker-compose.traefik.yml)
# ============================================================
# Public domain Traefik routes to this stack
DOMAIN=kinboard.example.com
# Name of the Traefik cert resolver in your Traefik static config
TRAEFIK_CERT_RESOLVER=letsencrypt
# External network Traefik watches
TRAEFIK_NETWORK=proxy

# ============================================================
# SMTP (Optional — for email features in Supabase Auth)
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com

# ============================================================
# External services (OPTIONAL — most are also configurable in
# the in-app Settings UI, per family)
# ============================================================
# OpenWeatherMap (free tier: https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=

# Immich (photo library for screensaver — also configurable per family in /settings/photos)
IMMICH_API_URL=
IMMICH_API_KEY=

# Google Calendar OAuth — configure at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bring! Shopping List (legacy script support — per-family creds live in /settings/bring)
BRING_EMAIL=
BRING_PASSWORD=

# ============================================================
# Cron / Auto-Sync
# ============================================================
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ============================================================
# Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
# ============================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ============================================================
# Auto-update — Diun + webhook (Optional)
# Shared secret between the Diun container and the webhook container
# that triggers kinboard-self-update.sh. Only used when the
# docker-compose.diun.yml overlay is enabled. Generate with:
#   openssl rand -hex 32
# setup.sh creates this automatically on first run if blank.
# ============================================================
DIUN_WEBHOOK_SECRET=

# Absolute host path to the kinboard repo (the directory containing
# webapp/, README.md, setup.sh). Bind-mounted into the webhook
# container at the SAME PATH so docker compose's relative paths
# resolve identically inside and outside — required because the
# webhook calls `docker compose` against the host daemon.
# Examples: /root/kinboard, /opt/kinboard, /mnt/user/appdata/kinboard.
# setup.sh auto-detects from the script's own location on first run.
KINBOARD_PROJECT_DIR=

# ============================================================
# Demo Mode (Optional)
# Set to a join code (e.g. DEMO01) on public demo deployments to
# surface a banner on /join showing the code. Leave blank for
# regular self-hosting installs. Pairs with the family seeded by
# webapp/docker/seed-demo.sql.
# ============================================================
KINBOARD_DEMO_FAMILY_CODE=

# ============================================================
# Cameras / go2rtc (Optional)
# Substituted into docker/go2rtc.yaml at container start. URL-encode
# any special characters in CAMERA_PASS (e.g. "#" → "%23").
# ============================================================
CAMERA_USER=admin
CAMERA_PASS=
HIKVISION_HOST=
AMCREST_HOST=

# WebRTC ICE candidates announced to clients (used by go2rtc).
# WEBRTC_LAN_IP: your server's LAN IP, so other LAN clients can connect directly.
# WEBRTC_PUBLIC_HOST: your public hostname for clients reaching you over WAN.
WEBRTC_LAN_IP=
WEBRTC_PUBLIC_HOST=
