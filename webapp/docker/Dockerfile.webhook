# Webhook executor image — `webhook` binary from adnanh/webhook plus
# git + docker CLI so kinboard-self-update.sh can run end-to-end inside
# the container.
#
# Published-image alternative (almir/webhook) ships with only the
# webhook binary on a busybox base, so it can't actually `git pull` or
# `docker compose` — exactly the things the update script needs to do.
#
# Two uses of one image, both published multi-arch by docker.yml:
#
#   - kinboard-webhook: the Diun overlay's webhook on a git install
#     (docker-compose.diun.yml), pulled under the webapp's tag. Households
#     used to build it here on their first `compose up` (kinboard-webhook:local;
#     docker-compose.webhook-build.yml still does, for whoever needs to). The
#     webhook runs the checkout's own kinboard-self-update.sh through the
#     project mount, never the copy below, so a `git pull` updates it.
#   - kinboard-updater (RFC-023
#     §4.11.3): compose.yml's `updater` service, under the `autoupdate`
#     profile, for an install with no git checkout. That has no script of
#     its own on disk, so the image carries it, and `kinboard-updater` runs
#     its loop. jq is for its container mode (Portainer's web-editor
#     stacks), which rebuilds each container's create request from Docker's
#     own description of it.

FROM alpine:3.20

# TARGETARCH is set automatically by buildkit (amd64 or arm64).
ARG TARGETARCH

RUN apk add --no-cache \
      git \
      docker-cli \
      docker-cli-compose \
      ca-certificates \
      bash \
      curl \
      jq \
      openssh-client \
      openssl \
      tzdata

# Pin webhook to a known release so a future upstream change can't
# silently shift behaviour.
ARG WEBHOOK_VERSION=2.8.2
RUN curl -fsSL "https://github.com/adnanh/webhook/releases/download/${WEBHOOK_VERSION}/webhook-linux-${TARGETARCH}.tar.gz" \
    | tar -xz -C /tmp \
 && mv "/tmp/webhook-linux-${TARGETARCH}/webhook" /usr/local/bin/webhook \
 && chmod +x /usr/local/bin/webhook \
 && rm -rf /tmp/webhook-linux-${TARGETARCH}

# The script, for kinboard-updater. A git install's webhook never runs this
# copy: its hook and its tick run the checkout's (diun/hooks.yaml, the
# overlay's entrypoint), which `git pull` keeps current, whichever release
# the image itself comes from.
COPY kinboard-self-update.sh /usr/local/bin/kinboard-self-update.sh
RUN chmod 0755 /usr/local/bin/kinboard-self-update.sh \
 && printf '%s\n' '#!/bin/sh' \
      '# kinboard-updater: automatic image-only updates of a one-file install (RFC-023 §4.11.3).' \
      'export KINBOARD_UPDATER=1' \
      'exec sh /usr/local/bin/kinboard-self-update.sh --tick-loop' \
      > /usr/local/bin/kinboard-updater \
 && chmod 0755 /usr/local/bin/kinboard-updater

# Healthy while its loop (the updater) or the webhook (a git install) runs.
# `[.]` keeps the pattern from matching this check's own command line.
HEALTHCHECK --interval=5m --timeout=10s --start-period=1m --retries=2 \
  CMD pgrep -f 'kinboard-self-update[.]sh --tick-loop' >/dev/null || pgrep -x webhook >/dev/null || exit 1

EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/webhook"]
