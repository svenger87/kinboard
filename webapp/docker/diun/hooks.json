[
  {
    "id": "kinboard-update",
    "execute-command": "/scripts/kinboard-self-update.sh",
    "command-working-directory": "/project",
    "response-message": "kinboard-self-update fired",
    "include-command-output-in-response": false,
    "include-command-output-in-response-on-error": true,
    "trigger-rule": {
      "match": {
        "type": "value",
        "value": "{{ getenv \"DIUN_WEBHOOK_SECRET\" }}",
        "parameter": {
          "source": "header",
          "name": "X-Diun-Token"
        }
      }
    }
  }
]
