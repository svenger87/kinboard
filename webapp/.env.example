# ============================================================
# Kinboard — Environment Variables Example
# ============================================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Do NOT commit real credentials.
#
# Most integrations are optional and configured per-family in
# the in-app /settings UI. The values below cover what the
# Next.js server needs at boot.
# ============================================================


# ─── Database (REQUIRED) ────────────────────────────────────
# `next dev` against the docker stack: bring up db + rest with the dev
# overlay, which publishes PostgREST on loopback:
#   cd docker && docker compose -f docker-compose.yml -f ../../scripts/dev/docker-compose.dev.yml up -d db db-init rest
# The browser talks to this dev server's own /rest/v1, which forwards here.
POSTGREST_URL=http://localhost:3010
# No anon key: the browser sends none since 1.18, and PostgREST runs such a
# request as its anon role. An old NEXT_PUBLIC_SUPABASE_ANON_KEY line here is
# harmless and can go.

# Live updates LISTEN on Postgres directly (POSTGRES_PORT from docker/.env).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=

# Uploaded files; any directory you can write.
FILES_DIR=./.files

# The secret PostgREST checks tokens with: JWT_SECRET from docker/.env.
# Family tokens are signed with it.
JWT_SECRET=

# Service-role key, for server code only: it bypasses row-level security.
# Keep this secret. Leave it empty and the server derives it from
# JWT_SECRET, or paste SERVICE_ROLE_KEY from docker/.env. The older name
# SUPABASE_SERVICE_ROLE_KEY is still read when this one is empty.
KINBOARD_SERVICE_ROLE_KEY=


# ─── Web Push Notifications (REQUIRED for /api/notifications) ───
# Generate with: npx web-push generate-vapid-keys
# Both keys come out of one command — copy each to its slot.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com


# ─── Cron / Scheduled jobs (REQUIRED if using cron endpoints) ───
# Generate with: openssl rand -base64 32
# Used by the cron container to call /api/cron/* with auth.
CRON_SECRET=your-cron-secret-here

# ─── Presence sensor (OPTIONAL) ──────────────────────────────
# Set to the same random value as KINBOARD_PRESENCE_TOKEN on the kiosk.
# A family's own token (Settings -> Devices) takes its place for that family.
PRESENCE_SENSOR_TOKEN=


# ─── Weather (OPTIONAL — disables weather features if blank) ───
# Free key: https://openweathermap.org/api
# A family's own key (Settings -> Weather) takes its place for that family.
OPENWEATHERMAP_API_KEY=


# ─── Google Calendar (OPTIONAL — for Google Calendar sync) ───
# Set up: https://console.cloud.google.com/apis/credentials
# Settings -> Google Calendar shows the redirect URI to register there, and
# takes a family's own client, which then wins over these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Unset, the redirect URI follows the address the app is opened on
# (http://localhost:3000/api/google/callback in dev). Set it only to pin one.
GOOGLE_REDIRECT_URI=


# ─── Camera streaming (OPTIONAL — for live camera widgets) ───
# go2rtc instance for WebRTC camera proxying.
# GO2RTC_URL=http://localhost:1984


# ─── Immich photo library — unused by the webapp ───
# Immich is set per family in Settings -> Photos; the webapp reads neither.
# IMMICH_API_URL=
# IMMICH_API_KEY=


# ─── Bring! shopping list — unused ───
# Bring! is signed in per family in Settings -> Bring!; nothing reads these.
# BRING_EMAIL=
# BRING_PASSWORD=
