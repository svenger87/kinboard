# ============================================================
# Kinboard — Environment Variables Example
# ============================================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Do NOT commit real credentials.
#
# Most integrations are optional and configured per-family in
# the in-app /settings UI. The values below cover what the
# Next.js server needs at boot.
# ============================================================


# ─── Database (REQUIRED) ────────────────────────────────────
# `next dev` against the docker stack: bring up db + rest with the dev
# overlay, which publishes PostgREST on loopback:
#   cd docker && docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db db-init rest
# The browser talks to this dev server's own /rest/v1, which forwards here.
POSTGREST_URL=http://localhost:3010
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Live updates LISTEN on Postgres directly (POSTGRES_PORT from docker/.env).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=

# Uploaded files; any directory you can write.
FILES_DIR=./.files

# Service-role key — required for admin operations (cron, server actions
# that bypass RLS). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ─── Web Push Notifications (REQUIRED for /api/notifications) ───
# Generate with: npx web-push generate-vapid-keys
# Both keys come out of one command — copy each to its slot.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com


# ─── Cron / Scheduled jobs (REQUIRED if using cron endpoints) ───
# Generate with: openssl rand -base64 32
# Used by the cron container to call /api/cron/* with auth.
CRON_SECRET=your-cron-secret-here


# ─── Weather (OPTIONAL — disables weather features if blank) ───
# Free key: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=


# ─── Google Calendar (OPTIONAL — for Google Calendar sync) ───
# Set up: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to http://localhost:3000/api/google/callback when unset.
# In production, set to https://<your-domain>/api/google/callback
GOOGLE_REDIRECT_URI=


# ─── Camera streaming (OPTIONAL — for live camera widgets) ───
# go2rtc instance for WebRTC camera proxying.
# GO2RTC_URL=http://localhost:1984


# ─── Immich photo library (OPTIONAL — used by scripts/, not webapp) ───
# Per-family Immich settings live in the in-app /settings/immich
# UI, not env vars. These are only for offline scripts.
# IMMICH_API_URL=
# IMMICH_API_KEY=


# ─── Bring! shopping list (OPTIONAL — legacy script support) ───
# Per-family Bring credentials live in the in-app /settings/bring
# UI. These are only for offline scripts.
# BRING_EMAIL=
# BRING_PASSWORD=
