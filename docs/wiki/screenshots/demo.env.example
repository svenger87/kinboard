# Demo stack env. Copy to demo.env (gitignored) and fill in.
# scripts/2-bringup.sh generates demo.env automatically on first run if missing.

# Prefix every container so we don't collide with a live prod-on-localhost.
PROJECT_NAME=familyboard-demo

# Where docker volumes land. Keep separate from prod's appdata path.
DATA_DIR=./data

# Demo runs on a single port; no Traefik.
DOMAIN=localhost
WEBAPP_PORT=3201
KONG_PORT=8001

# Timezone (date formatting in screenshots)
TZ=Europe/Berlin

# Disable Traefik discovery for demo
TRAEFIK_NETWORK=none
TRAEFIK_CERT_RESOLVER=none

# Generated by 2-bringup.sh — these are demo-only and never used in prod.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_USERNAME=demo
DASHBOARD_PASSWORD=demo

# VAPID keys for push (generated by setup.sh equivalent — empty disables push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@familyboard.local

# Cron secret (cron jobs disabled in demo so this is unused but compose expects it)
CRON_SECRET=demo-cron-secret-not-real

# OpenWeatherMap — leave blank to fall back to mock
OPENWEATHER_API_KEY=

# Supabase auth (gotrue) — Familyboard doesn't use email auth, but gotrue
# crash-loops if SMTP_PORT or API_EXTERNAL_URL is empty. Dummy values fine.
SITE_URL=http://localhost:3201
ADDITIONAL_REDIRECT_URLS=http://localhost:3201
API_EXTERNAL_URL=http://localhost:3201
SMTP_HOST=mail.example.invalid
SMTP_PORT=587
SMTP_USER=demo
SMTP_PASS=demo
SMTP_ADMIN_EMAIL=demo@familyboard.local

# Storage settings — supabase storage needs an internal URL/host
STORAGE_BACKEND=file
GLOBAL_S3_BUCKET=
FILE_SIZE_LIMIT=52428800
TENANT_ID=demo
