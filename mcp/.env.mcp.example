# Kinboard origin reachable from the gateway host. Use HTTPS unless local HTTP
# is explicitly trusted. Create a dedicated Integration API token in Settings.
KINBOARD_URL=https://kinboard.example.com/
KINBOARD_INTEGRATION_TOKEN=kbi_replace_with_one_time_token
# KINBOARD_ALLOW_HTTP=1

# Exact public MCP URL; reverse proxy HTTPS to 127.0.0.1:MCP_PORT.
MCP_PUBLIC_URL=https://mcp.example.com/mcp
MCP_PORT=8787

# OAuth authorization server. Its discovery metadata must support authorization
# code + PKCE S256 and registered ChatGPT/Claude OAuth clients. The access token's
# issuer and audience must match MCP_AUTH_ISSUER and MCP_PUBLIC_URL exactly.
MCP_AUTH_ISSUER=https://identity.example.com/
MCP_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# Comma-separated OAuth `sub` values allowed into this household. Required.
MCP_ALLOWED_SUBJECTS=replace_with_allowed_subject
# MCP_ALLOWED_ORIGINS=https://another-approved-client.example
