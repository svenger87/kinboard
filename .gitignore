webapp/nul
.claude/settings.local.json
run-claude-resume.sh

# Temp debug output from Playwright/Chrome DevTools MCP sessions
.playwright-mcp/
.superpowers/

# UX audit before-shots — tasks.md is tracked, screenshots are not (too large)
audit/*.png

# Local env / secrets — never commit anywhere in the repo
.env
.env.*
!.env.example
!.env.*.example
*.local
vapid-keys.json
*.pem
*.key
secrets/
deploy-config.local.sh

# SSH keys — never track. Generic + the previously-leaked file by name.
id_rsa
id_ed25519
id_ecdsa
id_dsa
id_*_*
*.pub
known_hosts

# Backup archives (don't belong in source control)
*.tar.gz
*.tar
*.tgz
*.zip
*.bak

# Local deployment overrides
docker-compose.override.yml
kong.local.yml
# Exception: the screenshot demo's compose override IS part of the toolchain,
# not a local override — it ships with the repo.
!docs/wiki/screenshots/docker-compose.override.yml

# Node deps (any node_modules, anywhere in the tree)
node_modules/

# There's no root package.json — webapp/ has its own. Block any stray
# root-level package-lock.json that something might re-create.
/package-lock.json

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
hetzner-api-key
CLAUDE.md
New Logos/
ToDo.md
_backups/

# Diun's runtime database and any other container runtime state under the
# docker data dir. This is written constantly at runtime and was committed by
# accident — a tracked copy collides with each host's local one and aborts the
# auto-update git pull. Runtime state does not belong in git.
webapp/docker/data/
