# not a local override — it ships with the repo.
!docs/wiki/screenshots/docker-compose.override.yml

# Node deps (any node_modules, anywhere in the tree)
node_modules/

# There's no root package.json — webapp/ has its own. Block any stray
# root-level package-lock.json that something might re-create.
/package-lock.json

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
hetzner-api-key
CLAUDE.md
New Logos/
ToDo.md
_backups/

# Diun's runtime database and any other container runtime state under the
# docker data dir. This is written constantly at runtime and was committed by
# accident — a tracked copy collides with each host's local one and aborts the
# auto-update git pull. Runtime state does not belong in git.
webapp/docker/data/

# The ${DATA_DIR} bind mounts, for installs where DATA_DIR points at the repo
# itself. Self-hosting tells NAS users to set DATA_DIR=/mnt/user/appdata/kinboard
# — the same directory the repo is cloned into — so on those installs the live
# PostgreSQL cluster, the uploaded recipe images and avatars, and any database
# dumps all sit untracked in the working tree. `git add -A` then stages the
# database, and `git clean -fd` deletes it. Anchored to the repo root with a
# leading slash so a source directory of the same name elsewhere in the tree is
# unaffected.
/db/
/storage/
/backups/

# Internal notes — pentest reports, host-specific diagnostics. These name
# real instances and must never be published to the public repo.
docs/internal/

# Local planning scratch from the superpowers workflow — design plans and
# specs. Working notes, not project docs; kept out of the public repo.
docs/superpowers/

# Generated at runtime by webapp/docker/test-upgrade.sh — the "after" half of
# an upgrade run. Regenerated on every run; never edited by hand.
webapp/docker/docker-compose.upgrade-target.yml
