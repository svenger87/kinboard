# Default: let git auto-detect text vs binary, normalize on commit.
* text=auto

# Force LF on every shell script + Python script + Node ESM script that
# ships in this repo, regardless of the contributor's OS. Bash on Linux
# refuses to interpret \r as part of a command and fails with cryptic
# "$'\r': command not found" errors otherwise.
*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf

# Same for any config files Linux services + Docker actually parse
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.conf  text eol=lf
*.ini   text eol=lf
Dockerfile text eol=lf
.env       text eol=lf
.env.*     text eol=lf
*.env      text eol=lf
*.env.*    text eol=lf

# Binaries — never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.gz    binary
*.tar   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary

# CHANGELOG conflicts on essentially every branch, because every PR appends
# to the same `[Unreleased]` section — the entries are independent, so the
# resolution is always "keep both". `union` is git's built-in driver for
# exactly that: it takes both sides of a conflicting hunk instead of
# stopping. Five PRs in one afternoon each needed a hand-resolve without it.
#
# It is not magic. Union can interleave two entries inside the same section
# in an odd order, and it will happily keep both halves of a line someone
# genuinely rewrote. So: read the merged section before pushing a release,
# and reorder if it reads badly. That is a far smaller job than resolving
# the same conflict on every branch.
CHANGELOG.md merge=union
